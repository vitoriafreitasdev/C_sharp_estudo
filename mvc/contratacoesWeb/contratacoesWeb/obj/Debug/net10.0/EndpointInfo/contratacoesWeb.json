              "type": "string"
            }
          },
          "linkedin": {
            "type": [
              "null",
              "string"
            ]
          },
          "portfolio": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Endereco": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "rua": {
            "type": "string"
          },
          "cep": {
            "type": "string"
          }
        }
      },
      "LoginCandidato": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      }
    }
