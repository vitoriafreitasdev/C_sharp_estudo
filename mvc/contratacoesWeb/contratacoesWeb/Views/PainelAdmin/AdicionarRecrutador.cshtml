<div>
    <p>@ViewBag.Mensagem</p> 
    <form asp-action="AdicionarRecrutadorPost" asp-controller="PainelAdmin" method="post">
        <div class="form-group">
            <label>Nome</label>
            <input name="nome" class="form-control" />
        </div>
        <div class="form-group">
            <label>Email</label>
            <input name="email" class="form-control" />
        </div>

        <div class="form-group">
            <label>Senha (Pelo menos um(a): letra maiúscula, minúscula, charactere especial e número)</label>
            <input name="senha" class="form-control" />
        </div>

        <button class="btn-painelAdmin" type="submit">
            Adicionar
        </button>
	</form>
</div>

