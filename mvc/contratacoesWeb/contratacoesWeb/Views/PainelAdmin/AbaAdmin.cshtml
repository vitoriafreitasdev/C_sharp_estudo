@{
    ViewData["Title"] = "AbaAdmin";
}
@model IEnumerable<contratacoesWeb.Models.Vagas>;

<div class="painel-admin">
    <aside class="menu-admin">
        <div class="menu-admin-conteudo">

            <a asp-controller="PainelAdmin"
               asp-action="AdicionarVaga"
               class="btn-admin">
                Adicionar vaga
            </a>

            <a asp-controller="PainelAdmin"
               asp-action="AdicionarRecrutador"
               class="btn-admin">
                Adicionar recrutador
            </a>

            <a asp-controller="PainelAdmin"
               asp-action="AbaAdmin"
               class="btn-admin">
                Visualizar vagas
            </a>
        </div>
    </aside>
    <main class="conteudo-admin">
        <div class="vagas-grid">
            @{
                if(Model != null && Model.Count() > 0)
                {
                    @foreach (Vagas vaga in Model)
                    {
                        <div class="vaga-card">
                            <h3>@vaga.titulo</h3>
                            <div class="vaga-info">
                                <p>
                                    <strong>Modelo:</strong>
                                    @vaga.modelo
                                </p>

                                <p>
                                    <strong>Tipo:</strong>
                                    @vaga.tipo
                                </p>
                            </div>
                            <div class="vaga-acoes">

                                <a asp-controller="PainelAdmin"
                                   asp-action="DetalhesVaga"
                                   asp-route-id=@vaga.id
                                   class="btn-vaga">
                                    Ver detalhes
                                </a>

                                <a asp-controller="PainelAdmin"
                                   asp-action="Candidatos"
                                   class="btn-vaga btn-candidatos">
                                    Candidatos
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p>Não tem vagas adicionadas.</p>
                }
            }
        </div>
    </main>
</div>